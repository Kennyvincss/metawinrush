# Leave these empty to run METAWIN RUSH in offline mode (progress saved on the device).
# Fill them in to enable accounts, the global leaderboard, the Arena and server-validated progression.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose this to the browser. Used by the /api routes to write validated results.
SUPABASE_SERVICE_ROLE_KEY=
